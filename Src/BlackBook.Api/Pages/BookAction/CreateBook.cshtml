@page
@model BlackBook.Api.Pages.BookAction.CreateBookModel
@{
    Layout = "/Pages/_Layout.cshtml";
    ViewData["Title"] = "Новая книга";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="bb-title"><i class="bi bi-plus-circle"></i> Новая книга</h2>
    <a href="/Library" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>&nbsp; К списку</a>
</div>

<div class="bb-card p-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        </div>
    }
    <form method="post" enctype="multipart/form-data" id="bookForm">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="title" class="form-label fw-semibold">Название <span class="text-danger">*</span></label>
                <input type="text" id="title" name="BookAddRequestModel.Title" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label for="author" class="form-label fw-semibold">Автор <span class="text-danger">*</span></label>
                <input type="text" id="author" name="BookAddRequestModel.Author" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label for="genre" class="form-label fw-semibold">Жанр</label>
                <input type="text" id="genre" name="BookAddRequestModel.Genre" class="form-control" />
            </div>
            <div class="col-md-4">
                <label for="year" class="form-label fw-semibold">Год издания</label>
                <input type="number" id="year" name="BookAddRequestModel.Year" class="form-control" min="0" max="9999" />
            </div>
            <div class="col-md-4">
                <label for="pages" class="form-label fw-semibold">Страниц</label>
                <input type="number" id="pages" name="BookAddRequestModel.Pages" class="form-control" min="1" />
            </div>
            <div class="col-12">
                <label for="toc" class="form-label fw-semibold">
                    <i class="bi bi-list-ul"></i> Оглавление
                    <span class="fw-normal text-muted">— редактор; сохранится в БД как XML</span>
                </label>
                <textarea id="toc" name="BookAddRequestModel.Toc"></textarea>
            </div>
            <div class="col-12">
                <label for="pdfFile" class="form-label fw-semibold">
                    <i class="bi bi-file-earmark-pdf"></i> Файл книги (PDF) <span class="fw-normal text-muted">— необязательно, хранится в облаке MEGA</span>
                </label>
                <input type="file" id="pdfFile" name="BookAddRequestModel.File" class="form-control" accept=".pdf" />
                <div class="form-text">Файл загружается в облако MEGA. Для загрузки необходимо подключение к MEGA.</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>&nbsp; Создать</button>
            <a href="/Library" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
        $(document).ready(function () {
            // WYSIWYG-редактор оглавления; содержимое сохраняется в БД как XML
            $('#toc').summernote({
                height: 250,
                placeholder: 'Оглавление книги: главы, разделы...'
            });

            // Перед отправкой формы кладём HTML из редактора в textarea
            $('#bookForm').on('submit', function () {
                $('#toc').val($('#toc').summernote('code'));
            });
        });
    </script>
}
